# LUL Terminal — production for https://luldev.me
# Reverse proxy (nginx/Caddy/Cloudflare) terminates TLS → Node on PORT.
# Never commit this file (.gitignore: .env*).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Secure session cookies (HTTPS). Explicit so local misconfig cannot weaken prod.
COOKIE_SECURE=1

# ── Reverse proxy / real client IPs ───────────────────────────────────────────
# Required behind nginx, Caddy, Cloudflare, etc.
TRUST_PROXY=1
# Only these hops may set X-Forwarded-* (default loopback; add proxy private IPs if needed).
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# ── Public origin (paste / image / referral absolute URLs) ─────────────────────
PUBLIC_BASE_URL=https://luldev.me
# Host allow-list for X-Forwarded-Host when TRUST_PROXY=1
ALLOWED_PUBLIC_HOSTS=luldev.me,www.luldev.me

# ── Redis (optional — multi-instance rate limits / view dedup) ────────────────
# Uncomment when Redis is available:
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_BACKEND=auto
# GUEST_VIEW_DEDUP_BACKEND=auto

# ── Auth bootstrap (only used if SQLite has zero users) ───────────────────────
# Existing data/auth/lul-auth.sqlite is NOT re-seeded from these values.
SEED_ADMIN_EMAIL=admin@luldev.me
SEED_ADMIN_PASSWORD=SecureAdminPass99

# ── Premium vault encryption ──────────────────────────────────────────────────
# KEEP this value stable — changing it makes existing vault ciphertext unreadable.
# Back up this key offline with data/premium-accounts/.
PREMIUM_VAULT_KEY=local-dev-vault-key-not-for-prod-32b

# ── Optional ──────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=
DISABLE_HMR=true
